# Copiar a .env y ajustar. El .env NO se versiona.
#
#   docker run --env-file .env ...

# Puerto en el que escucha la única URL pública del servicio.
BA_PUERTO=8080

# Nombre de la casa donde corre. Sale en cada línea de la bitácora.
BA_CASA=casa-tomas

# Réplicas iniciales, separadas por coma. Puede quedar vacío: cada casa se
# registra sola por POST /admin/backends cuando corre su deploy.sh. La forma
# es host:puerto, o host:puerto=java para que vuelvan bien etiquetadas tras
# un reinicio (sin la etiqueta se asume python).
BA_BACKENDS=100.120.186.92:8080,100.78.246.64:8081,100.118.61.111:8111=java,100.118.61.111:8112=java

# Cada cuánto le pregunta a cada réplica si sigue viva (segundos).
BA_INTERVALO_SALUD=3
# Cuántas respuestas malas seguidas la sacan de rotación.
BA_FALLOS_PARA_SACAR=2

# --- Plano de control ---
# /admin/backends vive en un puerto aparte. El puerto público devuelve 404 en
# /admin. Por defecto el código lo ata a loopback; acá se abre porque cada casa
# conmuta desde su propia máquina.
BA_PUERTO_ADMIN=8081
BA_ADMIN_BIND=0.0.0.0
# Segunda barrera, y obligatoria cuando el bind no es loopback: las IPs de
# tailnet que pueden conmutar, separadas por coma. Vacío = sólo loopback.
# Están TODAS las casas del tailnet, no sólo las que hoy tienen réplica: una
# casa que se suma no debería necesitar que reiniciemos el balanceador.
BA_ADMIN_IPS=127.0.0.1,100.101.15.93,100.118.61.111,100.120.186.92,100.126.21.33,100.78.246.64,100.79.41.92,100.91.134.43,100.99.113.83
