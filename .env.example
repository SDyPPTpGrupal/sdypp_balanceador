# Copiar a .env y ajustar. El .env NO se versiona.
#
#   docker run --env-file .env ...
#
# Esto configura sólo AL BALANCEADOR. El sistema de colas es otro repo
# (sdypp_colas_serv) con su propio despliegue y su propio .env: cada uno
# documenta lo suyo. Lo único que tiene que coincidir entre los dos es
# BA_COLA_TOKEN de acá con COLA_TOKEN_PUBLICADOR (o su respaldo COLA_TOKEN)
# del lado de la cola — ahí es donde se equivoca uno.

# Puerto en el que escucha la única URL pública del servicio.
BA_PUERTO=8080

# Nombre de la casa donde corre. Sale en cada línea de la bitácora.
BA_CASA=casa-tomas

# --- La cola ---
# Lista de nodos del clúster de colas, separada por comas (seed list). Un solo
# elemento también es válido: es la configuración de un clúster de un nodo, no
# un caso especial. Si corren en la misma máquina con --network host, loopback
# alcanza y es lo más seguro: el balanceador no necesita salir a la red.
BA_COLA_URL=http://127.0.0.1:8085,http://127.0.0.1:8086,http://127.0.0.1:8087
# Tiene que ser COLA_TOKEN_PUBLICADOR (o su respaldo COLA_TOKEN) del lado de la
# cola. Sin esto el balanceador no puede ni publicar ni recolectar, y todo
# contesta 503.
BA_COLA_TOKEN=cambiar-por-algo-largo-y-aleatorio

# Con qué nombre se identifica ante la cola. La cola guarda sus respuestas bajo
# este nombre y no se las da a nadie más; con dos balanceadores (Etapa 3) cada
# uno tiene el suyo. Vacío = "<BA_NOMBRE>@<BA_CASA>", que ya es único.
# BA_IDENTIDAD=balanceador@casa-tomas

# Hilos que recolectan respuestas, cada uno con un long-poll abierto. Con uno
# solo, todas las respuestas del servicio pasarían por un round-trip serializado.
BA_RECOLECTORES=4
# Cuánto dura cada long-poll del recolector (segundos).
BA_ESPERA_RECOLECTOR=20

# Presupuesto total de un pedido en segundos, espera en la cola incluida.
BA_PRESUPUESTO=5
# Cuánto más que el presupuesto espera el handler antes de rendirse solo. Es la
# red de contención para el caso en que la cola misma deje de contestar: si
# salta este timeout y no el de la cola, el problema es la cola.
BA_GRACIA_COLA=1

# --- Réplicas y salud ---
# Réplicas iniciales, separadas por coma. Es lo que el registro rearma tras un
# reinicio; en el día a día las conmuta el CD por POST /admin/backends. La forma
# es host:puerto, o host:puerto=java para que vuelvan bien etiquetadas.
#
# Ojo: esto ya no decide a dónde va el tráfico. Una réplica atiende porque su
# worker consume de la cola, no porque figure acá. Esta lista es lo que /health
# cuenta y lo que el CD ve.
BA_BACKENDS=100.101.15.93:8090,100.91.134.43:8080,100.118.61.111:8111=java,100.118.61.111:8112=java

# Cada cuánto le pregunta a cada réplica si sigue viva (segundos). Desde que el
# balanceador no le hace RPCs de negocio a nadie, éste es el único aviso de una
# caída que hay de este lado.
BA_INTERVALO_SALUD=3
# Cuántas respuestas malas seguidas la marcan caída.
BA_FALLOS_PARA_SACAR=2

# --- Plano de control ---
# /admin/backends vive en un puerto aparte, atado a loopback. El único que lo
# usa es el CD, que corre en esta misma máquina con --network host.
BA_PUERTO_ADMIN=8081
# Sólo para un balanceador que corra en OTRA casa (Etapa 3): ahí se abre a su
# IP de Tailscale y se deja entrar únicamente a la IP de la Plataforma (el CD).
# BA_ADMIN_BIND=100.91.134.43
# BA_ADMIN_IPS=100.101.15.93
