# Copiar a .env y ajustar. El .env NO se versiona.
#
#   docker run --env-file .env ...

# Puerto en el que escucha la única URL pública del servicio.
BA_PUERTO=8080

# Nombre de la casa donde corre. Sale en cada línea de la bitácora.
BA_CASA=casa-tomas

# Réplicas iniciales, separadas por coma. Es lo que el pool rearma tras un
# reinicio; en el día a día las conmuta el CD por POST /admin/backends. La
# forma es host:puerto, o host:puerto=java para que vuelvan bien etiquetadas
# (sin la etiqueta se asume python).
BA_BACKENDS=100.101.15.93:8090,100.91.134.43:8080,100.118.61.111:8111=java,100.118.61.111:8112=java

# --- La cola ---
# Cuántos pedidos pueden esperar. Pasado eso, 503 en el acto: mejor que aceptar
# un pedido que casi seguro va a vencer.
BA_COTA_COLA=100
# Hilos worker por réplica = pedidos en vuelo máximos por réplica.
BA_WORKERS_POR_REPLICA=4
# Presupuesto total de un pedido en segundos, espera en cola incluida.
BA_TIMEOUT_RPC=5

# --- Salud ---
# Cada cuánto le pregunta a cada réplica si sigue viva (segundos).
BA_INTERVALO_SALUD=3
# Cuántas respuestas malas seguidas la sacan de rotación. Cuenta tanto el
# chequeo periódico como una request que encontró la réplica caída.
BA_FALLOS_PARA_SACAR=2

# --- Plano de control ---
# /admin/backends vive en un puerto aparte, atado a loopback. El único que lo
# usa es el CD, que corre en esta misma máquina con --network host. No hace
# falta abrirlo: BA_ADMIN_BIND y BA_ADMIN_IPS quedan en su default.
BA_PUERTO_ADMIN=8081
# Sólo para un balanceador que corra en OTRA casa (Etapa 3): ahí se abre a su
# IP de Tailscale y se deja entrar únicamente a la IP de la Plataforma (el CD).
# BA_ADMIN_BIND=100.91.134.43
# BA_ADMIN_IPS=100.101.15.93
