# Copiar a .env y ajustar. El .env NO se versiona.
#
#   docker run --env-file .env ...

# Puerto en el que escucha la única URL pública del servicio.
BA_PUERTO=8080

# Nombre de la casa donde corre. Sale en cada línea de la bitácora.
BA_CASA=casa-tomas

# Réplicas iniciales, separadas por coma. Puede quedar vacío: el CI/CD las
# carga por POST /admin/backends cuando despliega.
BA_BACKENDS=100.91.134.43:8080,100.78.246.64:8080

# Cada cuánto le pregunta a cada réplica si sigue viva (segundos).
BA_INTERVALO_SALUD=3
# Cuántas respuestas malas seguidas la sacan de rotación.
BA_FALLOS_PARA_SACAR=2

# --- Plano de control ---
# /admin/backends vive en un puerto aparte que escucha SÓLO en loopback: el
# CI/CD corre en la misma máquina, así que no necesita salir a la red. El puerto
# público devuelve 404 en /admin.
BA_PUERTO_ADMIN=8081
BA_ADMIN_BIND=127.0.0.1
# Segunda barrera, por si algún día hay que abrirlo: IPs separadas por coma.
# Vacío = sólo loopback.
BA_ADMIN_IPS=
